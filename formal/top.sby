[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 40
bmc: aigsmt z3

[engines]
bmc: abc bmc3

[script]
read -formal pesm_sync.v pesm_fifo.v pesm_clkdiv.v pesm_core.v pesm_host.v tt_um_protocol_engine.v
prep -top tt_um_protocol_engine

